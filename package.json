{
  "name": "vault-notes-app",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "node --test tests/*.test.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:media-tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-media-tools.ps1",
    "stage:media-tools": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-media-tools.ps1",
    "tauri:build": "npm run stage:media-tools && tauri build",
    "portable": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-portable.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "dockview-react": "^7.0.4",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.24.0",
    "monaco-editor": "^0.55.1",
    "react": "^19.1.0",
    "react-arborist": "^3.13.2",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
